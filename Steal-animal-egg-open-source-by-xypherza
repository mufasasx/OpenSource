task.spawn(function()
	while ScreenGui.Parent do
		if not autoFarm then
			task.wait(0.15)
			continue
		end

		local egg = getNearestEgg()

		if not egg then
			setStatus("No " .. selectedRarity .. " eggs")
			task.wait(0.5)
			continue
		end

		local prompt = egg.Prompt
		local eggModel = egg.Model

		if not eggModel or not eggModel.Parent or not prompt or not prompt.Parent then
			task.wait(0.1)
			continue
		end

		local teleported = teleportToPrompt(prompt)
		if not teleported then
			setStatus("Prompt not found")
			task.wait(0.3)
			continue
		end

		task.wait(0.2)

		setStatus("Stealing " .. tostring(egg.Rarity or "Egg"))
		triggerPrompt(prompt)

		local startTime = os.clock()
		repeat
			task.wait(0.1)
			if not autoFarm or not eggModel.Parent or not prompt.Parent then
				break
			end
		until os.clock() - startTime >= 1.2
		task.wait(0.1)
	end
end)

-- Draggable Window
local draggingWindow = false
local dragStart = nil
local startPosition = nil

Header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingWindow = true
		dragStart = input.Position
		startPosition = Main.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if draggingWindow and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		Main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingWindow = false
	end
end)


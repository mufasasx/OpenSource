-- Button Creator
local function createButton(text, y)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -20, 0, 28)
	btn.Position = UDim2.fromOffset(10, y)
	btn.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
	btn.BorderSizePixel = 0
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(220, 220, 225)
	btn.TextSize = 11
	btn.Font = Enum.Font.GothamMedium
	btn.Parent = Content

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(38, 38, 44)
	stroke.Thickness = 1
	stroke.Parent = btn

	btn.MouseEnter:Connect(function()
		btn.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
		stroke.Color = Color3.fromRGB(55, 55, 65)
	end)

	btn.MouseLeave:Connect(function()
		if btn.Name ~= "ActiveAutoBtn" then
			btn.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
			stroke.Color = Color3.fromRGB(38, 38, 44)
		end
	end)

	btn.MouseButton1Down:Connect(function()
		btn.Size = UDim2.new(1, -24, 0, 26)
		btn.Position = UDim2.fromOffset(12, y + 1)
	end)

	btn.MouseButton1Up:Connect(function()
		btn.Size = UDim2.new(1, -20, 0, 28)
		btn.Position = UDim2.fromOffset(10, y)
	end)

	return btn, stroke
end


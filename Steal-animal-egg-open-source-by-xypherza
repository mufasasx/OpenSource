-- Character Helpers
local function getCharacter()
	return Player.Character or Player.CharacterAdded:Wait()
end

local function getRoot()
	local char = getCharacter()
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
	local char = getCharacter()
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function applyMovement()
	local hum = getHumanoid()
	if not hum then return end

	hum.WalkSpeed = walkSpeed
	hum.UseJumpPower = true
	hum.JumpPower = jumpPower
end

Player.CharacterAdded:Connect(function(char)
	char:WaitForChild("Humanoid")
	task.wait(0.5)
	applyMovement()
end)

-- Teleport & Plot Functions
local function teleportToCFrame(cf)
	local char = getCharacter()
	if not char then return false end
	char:PivotTo(cf)
	return true
end

local function getMyPlot()
	for _, object in ipairs(workspace:GetChildren()) do
		if object:IsA("Model") and object.Name:match("^Base %d+$") then
			local ownerId = object:GetAttribute("OwnerUserId")
			if ownerId == Player.UserId then
				return object
			end
		end
	end
	return workspace:FindFirstChild("Base 3")
end

local function teleportToPlot()
	local plot = getMyPlot()
	if not plot then return false end

	local target = plot:FindFirstChild("BaseSpawn")
		or plot:FindFirstChild("SpawnPoint")
		or plot:FindFirstChild("PetYard")

	if not target then return false end

	if target:IsA("BasePart") then
		teleportToCFrame(target.CFrame + Vector3.new(0, 3, 0))
		return true
	end

	return false
end

-- Egg Scanner
local function getEggRarity(model)
	if not AnimalIndexArt then return nil end

	local success, result1, result2 = pcall(function()
		return AnimalIndexArt.tierOf(model)
	end)

	if not success then return nil end

	if typeof(result2) == "string" then
		return result2
	end

	if typeof(result1) == "string" then
		return result1
	end

	return nil
end

local function getEggs()
	local eggs = {}
	if not Zones then return eggs end

	for _, zone in ipairs(Zones:GetChildren()) do
		local eggBeds = zone:FindFirstChild("EggBeds")
		if eggBeds then
			for _, bed in ipairs(eggBeds:GetChildren()) do
				for _, object in ipairs(bed:GetChildren()) do
					if object:IsA("Model") then
						local prompt = object:FindFirstChildWhichIsA("ProximityPrompt", true)
						if prompt then
							table.insert(eggs, {
								Model = object,
								Prompt = prompt,
								Rarity = getEggRarity(object),
								Bed = bed,
								Zone = zone
							})
						end
					end
				end
			end
		end
	end

	return eggs
end

local function getNearestEgg()
	local hrp = getRoot()
	if not hrp then return nil end

	local closest = nil
	local closestDistance = math.huge

	for _, egg in ipairs(getEggs()) do
		local correctRarity = (selectedRarity == "Any" or egg.Rarity == selectedRarity)

		if correctRarity and egg.Model and egg.Model.Parent then
			local success, pivot = pcall(function()
				return egg.Model:GetPivot()
			end)

			if success then
				local distance = (hrp.Position - pivot.Position).Magnitude
				if distance < closestDistance then
					closestDistance = distance
					closest = egg
				end
			end
		end
	end

	return closest
end

-- Prompt Actions
local function getPromptPosition(prompt)
	if not prompt or not prompt.Parent then return nil end

	local parent = prompt.Parent
	if parent:IsA("Attachment") then return parent.WorldPosition end
	if parent:IsA("BasePart") then return parent.Position end

	local part = prompt:FindFirstAncestorWhichIsA("BasePart")
	return part and part.Position or nil
end

local function teleportToPrompt(prompt)
	local position = getPromptPosition(prompt)
	if not position then return false end

	local char = getCharacter()
	if not char then return false end

	local targetPosition = position + Vector3.new(0, 1.5, 2.5)
	char:PivotTo(CFrame.lookAt(targetPosition, position))

	return true
end

local function triggerPrompt(prompt)
	if not prompt or not prompt.Parent then return false end

	local oldDistance = prompt.MaxActivationDistance
	local oldLOS = prompt.RequiresLineOfSight
	local oldEnabled = prompt.Enabled

	prompt.Enabled = true
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = math.max(oldDistance, 30)

	task.wait(0.05)

	if fireproximityprompt then
		pcall(function()
			fireproximityprompt(prompt, prompt.HoldDuration)
		end)
	else
		pcall(function()
			prompt:InputHoldBegin()
			task.wait(math.max(prompt.HoldDuration, 0.05) + 0.05)
			prompt:InputHoldEnd()
		end)
	end

	task.delay(0.5, function()
		if prompt and prompt.Parent then
			prompt.MaxActivationDistance = oldDistance
			prompt.RequiresLineOfSight = oldLOS
			prompt.Enabled = oldEnabled
		end
	end)

	return true
end

local function teleportToEgg()
	local egg = getNearestEgg()
	if not egg then return false end

	if teleportToPrompt(egg.Prompt) then
		return true, egg
	end

	local success, pivot = pcall(function()
		return egg.Model:GetPivot()
	end)

	if not success then return false end

	teleportToCFrame(pivot + Vector3.new(0, 3, 0))
	return true, egg
end

